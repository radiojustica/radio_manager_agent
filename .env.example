# Copie este arquivo para .env e preencha com os valores reais
# NUNCA versione o arquivo .env

# Google Drive API
GDRIVE_API_KEY=sua_chave_aqui

# Gemini AI
GEMINI_API_KEY=sua_chave_aqui

# Telegram
TELEGRAM_BOT_TOKEN=seu_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# WhatsApp (Evolution API)
WHATSAPP_API_KEY=sua_chave_aqui
WHATSAPP_URL=https://api.exemplo.com
WHATSAPP_INSTANCE=OmniCore

# Email (Gmail App Password)
EMAIL_SENDER=seu_email@gmail.com
EMAIL_PASSWORD=sua_senha_de_app_aqui
EMAIL_TARGET=destino@gmail.com

# vMix
VMIX_IP=172.16.217.226
VMIX_PORT=8088
